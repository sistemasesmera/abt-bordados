---
---
<footer>
  <div class="top">
    <div class="brand">
      <a href="#hero" class="logo">
        <img src="/logo-abt.png" alt="ABT Bordados" />
      </a>
      <p class="tagline">Artesanía con hilo. Madrid.</p>
    </div>
    <nav>
      <a href="#servicios">Servicios</a>
      <a href="#galeria">Galería</a>
      <a href="#contacto">Contacto</a>
    </nav>
  </div>
  <div class="bottom">
    <p>© 2026 ABT Bordados y Arreglos · Paseo Santa María de la Cabeza 10, Madrid</p>
    <p class="legal"><a href="#">Política de privacidad</a></p>
  </div>
</footer>

<style>
  footer {
    background: var(--ink);
    padding: 3.5rem 5% 2rem;
  }

  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255,255,255,.1);
    margin-bottom: 1.8rem;
  }

  .logo {
    display: inline-block;
    margin-bottom: .4rem;
    text-decoration: none;
  }
  .logo img {
    height: 100px;
    width: auto;
    display: block;
  }

  .tagline {
    font-size: .78rem;
    color: rgba(255,255,255,.4);
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  nav { display: flex; gap: 2rem; align-items: center; }
  nav a {
    color: rgba(255,255,255,.5);
    font-size: .82rem;
    text-decoration: none;
    transition: color .18s;
    font-weight: 500;
  }
  nav a:hover { color: var(--yellow); }

  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: .5rem;
  }
  .bottom p { color: rgba(255,255,255,.3); font-size: .75rem; }
  .legal a { color: rgba(255,255,255,.3); text-decoration: none; font-size: .75rem; }
  .legal a:hover { color: rgba(255,255,255,.6); }

  @media (max-width: 600px) {
    .top { flex-direction: column; }
    nav { flex-wrap: wrap; gap: 1rem; }
    .bottom { flex-direction: column; align-items: flex-start; }
    footer { padding: 3rem 1.4rem 2rem; }
  }
</style>
