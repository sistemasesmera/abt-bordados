---
const planes = [
  {
    plan: 'Básico', name: 'Arreglos Simples',
    from: 'Desde', price: '5€', unit: '/ arreglo',
    featured: false,
    items: ['Dobladillos y bajos', 'Costura de botones', 'Arreglos pequeños', 'Entrega en 3-5 días'],
  },
  {
    plan: 'Popular', name: 'Bordado Personalizado',
    from: 'Desde', price: '12€', unit: '/ unidad',
    featured: true,
    badge: '⭐ Más solicitado',
    items: ['Nombre o texto bordado', 'Logo o diseño propio', 'Cualquier prenda o tejido', 'Colores a elegir', 'Entrega en 48h express'],
  },
  {
    plan: 'Empresas', name: 'Pedidos en Serie',
    from: 'Consultar según volumen', price: 'A medida', unit: '',
    featured: false,
    items: ['Desde 1 unidad', 'Descuentos por volumen', 'Logo corporativo', 'Factura para empresa', 'Gestión completa del pedido'],
  },
];
---

<section id="precios">
  <div class="section-header center reveal">
    <div class="section-tag">Tarifas orientativas</div>
    <h2 class="section-title">Precios Transparentes</h2>
    <p class="section-sub">Sin sorpresas. El presupuesto exacto siempre es gratis y sin compromiso.</p>
  </div>

  <div class="grid">
    {planes.map(p => (
      <div class:list={['card', p.featured && 'featured', 'reveal']}>
        {p.featured && p.badge && <div class="badge">{p.badge}</div>}
        <div class="plan">{p.plan}</div>
        <div class="name">{p.name}</div>
        <div class="from">{p.from}</div>
        <div class="price">{p.price} <span>{p.unit}</span></div>
        <ul>
          {p.items.map(item => <li>{item}</li>)}
        </ul>
        <a href="#contacto" class:list={['cta-btn', p.featured ? 'filled' : 'outline']}>
          {p.featured ? 'Pedir Presupuesto' : 'Consultar precio'}
        </a>
      </div>
    ))}
  </div>
</section>

<style>
  section { padding: 90px 5%; background: var(--black-soft); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.4rem;
    max-width: 880px;
    margin: 0 auto;
  }

  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 2rem;
    position: relative;
    transition: transform .3s, box-shadow .3s;
  }
  .card:hover { transform: translateY(-5px); box-shadow: 0 18px 50px rgba(0,0,0,.38); }
  .card.featured { border-color: var(--yellow); box-shadow: 0 0 0 1px rgba(255,208,0,.28), 0 16px 50px rgba(255,208,0,.09); }

  .badge {
    position: absolute;
    top: -13px; left: 50%; transform: translateX(-50%);
    background: var(--yellow);
    color: var(--black);
    font-family: var(--font-head);
    font-size: .68rem; font-weight: 800;
    letter-spacing: 1px; text-transform: uppercase;
    padding: .28rem .85rem;
    border-radius: 50px;
    white-space: nowrap;
  }

  .plan { font-family: var(--font-head); font-size: .72rem; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--yellow); margin-bottom: .4rem; }
  .name { font-family: var(--font-head); font-weight: 900; font-size: 1.4rem; margin-bottom: 1.2rem; }
  .from { color: var(--muted); font-size: .78rem; margin-bottom: .15rem; }
  .price { font-family: var(--font-head); font-weight: 900; font-size: 2.3rem; margin-bottom: 1.6rem; line-height: 1; }
  .price span { font-size: .95rem; color: var(--muted); font-weight: 400; }

  ul { list-style: none; margin-bottom: 1.8rem; }
  li {
    display: flex; align-items: center; gap: .65rem;
    padding: .45rem 0;
    border-bottom: 1px solid var(--border);
    font-size: .88rem; color: #ccc;
  }
  li::before { content: '✓'; color: var(--yellow); font-weight: 700; min-width: 14px; }

  .cta-btn {
    display: block; text-align: center;
    padding: .85rem;
    border-radius: 8px;
    font-family: var(--font-head); font-weight: 700; font-size: .92rem;
    text-decoration: none;
    transition: all .2s;
  }
  .filled { background: var(--yellow); color: var(--black); }
  .filled:hover { background: var(--yellow-dark); transform: translateY(-1px); }
  .outline { border: 1px solid #444; color: var(--white); }
  .outline:hover { border-color: var(--yellow); color: var(--yellow); }

  @media (max-width: 720px) { section { padding: 60px 1.2rem; } }
</style>
