---
const items = [
  {
    src: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=900&q=80',
    label: 'Bordados corporativos',
    big: true,
  },
  {
    src: 'https://images.unsplash.com/photo-1620799140408-edc6dcb6d633?auto=format&fit=crop&w=500&q=80',
    label: 'Bordado artesanal',
  },
  {
    src: 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=500&q=80',
    label: 'Ropa personalizada',
  },
  {
    src: 'https://images.unsplash.com/photo-1617306534798-3f5b1f02bde6?auto=format&fit=crop&w=500&q=80',
    label: 'Ropa de bebé',
  },
  {
    src: 'https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?auto=format&fit=crop&w=500&q=80',
    label: 'Ropa deportiva',
  },
  {
    src: 'https://images.unsplash.com/photo-1523381294911-8d3cead13475?auto=format&fit=crop&w=500&q=80',
    label: 'Arreglos de ropa',
  },
];
---

<section id="galeria">
  <div class="section-header center reveal">
    <div class="section-tag">Nuestro trabajo</div>
    <h2 class="section-title">Galería</h2>
    <p class="section-sub">Una muestra de lo que hacemos cada día en nuestro taller.</p>
  </div>

  <div class="grid">
    {items.map(item => (
      <div class:list={['item', item.big && 'big', 'reveal']}>
        <img src={item.src} alt={item.label} loading="lazy" />
        <div class="overlay">
          <span>{item.label}</span>
        </div>
      </div>
    ))}
  </div>

  <p class="cta-note reveal">
    ¿Quieres ver más? <a href="#contacto">Pídenos un portfolio completo →</a>
  </p>
</section>

<style>
  section { padding: 90px 5%; background: var(--bg-alt); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: .6rem;
  }

  .item {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 1;
    cursor: pointer;
  }
  .item.big { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; }

  .item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .5s ease;
  }
  .item:hover img { transform: scale(1.06); }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.65) 0%, transparent 50%);
    display: flex;
    align-items: flex-end;
    padding: 1rem 1.1rem;
    opacity: 0;
    transition: opacity .28s;
  }
  .item:hover .overlay { opacity: 1; }

  .overlay span {
    color: #fff;
    font-size: .8rem;
    font-weight: 700;
    font-family: var(--font-head);
    letter-spacing: .03em;
    text-transform: uppercase;
  }

  .cta-note {
    margin-top: 2.2rem;
    text-align: center;
    font-size: .88rem;
    color: var(--muted);
  }
  .cta-note a {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid var(--yellow);
    padding-bottom: 1px;
    transition: border-color .18s;
  }
  .cta-note a:hover { border-color: var(--ink); }

  @media (max-width: 680px) {
    section { padding: 70px 1.4rem; }
    .grid { grid-template-columns: 1fr 1fr; }
    .item.big { grid-column: span 2; grid-row: span 1; aspect-ratio: 16/9; }
  }
</style>
