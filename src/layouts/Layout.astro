---
interface Props { title?: string; }
const { title = 'ABT Bordados y Arreglos' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ABT Bordados y Arreglos — Bordados personalizados y arreglos de ropa en Madrid." />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --yellow:      #F5C400;
    --yellow-dark: #D4A800;
    --yellow-pale: #FFFBEB;
    --ink:         #111111;
    --text:        #2E2C29;
    --muted:       #6B6860;
    --border:      #E5E2DB;
    --bg:          #FFFFFF;
    --bg-alt:      #F6F4EF;
    --font-head:   'Montserrat', sans-serif;
    --font-body:   'Montserrat', sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--text);
    overflow-x: hidden;
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    font-family: var(--font-body);
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: .75rem;
  }
  .section-tag::before {
    content: '';
    display: block;
    width: 18px;
    height: 2px;
    background: var(--yellow);
    flex-shrink: 0;
  }

  .section-title {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    line-height: 1.1;
    color: var(--ink);
    margin-bottom: .8rem;
  }

  .section-sub {
    color: var(--muted);
    font-size: .95rem;
    line-height: 1.75;
    max-width: 520px;
  }

  .section-header { margin-bottom: 3rem; }
  .section-header.center { text-align: center; }
  .section-header.center .section-sub { margin: 0 auto; }
  .section-header.center .section-tag { justify-content: center; }
  .section-header.center .section-tag::before { display: none; }

  .btn-yellow {
    display: inline-block;
    background: var(--yellow);
    color: var(--ink);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: .9rem;
    padding: .85rem 1.8rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background .18s, transform .15s;
  }
  .btn-yellow:hover { background: var(--yellow-dark); transform: translateY(-2px); }

  .btn-outline {
    display: inline-block;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: .9rem;
    padding: .85rem 1.8rem;
    border-radius: 4px;
    border: 2px solid var(--ink);
    text-decoration: none;
    transition: background .18s, color .18s;
  }
  .btn-outline:hover { background: var(--ink); color: #fff; }

  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .55s ease, transform .55s ease;
  }
  .reveal.visible { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>
